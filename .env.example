# Local Development Environment Variables
# Copy this file to .env and fill in your actual values

# Raspberry Pi Connection Details
PI_HOST=192.168.1.100          # Your Pi's IP address or hostname
PI_USER=pi                     # SSH username (usually 'pi')  
PI_SSH_KEY_PATH=~/.ssh/id_rsa  # Path to your SSH private key

# Optional: Custom deployment settings
DEPLOYMENT_NAME=blog-dev       # Custom deployment name
BACKUP_COUNT=5                 # Number of backups to keep
HEALTH_CHECK_TIMEOUT=30        # Health check timeout in seconds

# Django Local Settings (for local development)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-local-secret-key-here

# Local Database (if using PostgreSQL locally)
# DB_NAME=blog_local
# DB_USER=your_db_user  
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432