# Raspberry Pi Deployment Configuration Template
# Copy this file to .env.pi.deploy and fill in your actual values

# Raspberry Pi Connection Details
PI_HOST=192.168.1.100          # Your Pi's IP address or hostname
PI_USER=pi                     # SSH username (usually 'pi')
PI_SSH_KEY_PATH=~/.ssh/id_rsa  # Path to your SSH private key

# Django Environment Variables for Raspberry Pi Deployment
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_PI_IP_HERE
DJANGO_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://YOUR_PI_IP_HERE

# Database Configuration
DB_NAME=blog_pi_db
DB_USER=blog_user
DB_PASSWORD=secure_blog_password_change_this

# Compose Project Name (to avoid conflicts)
COMPOSE_PROJECT_NAME=blog_pi

# Optional: Custom deployment settings
DEPLOYMENT_NAME=blog-prod      # Custom deployment name
BACKUP_COUNT=5                 # Number of backups to keep
HEALTH_CHECK_TIMEOUT=30        # Health check timeout in seconds

# Docker Registry (if using)
# DOCKER_REGISTRY=your-registry.com
# DOCKER_USERNAME=your-username