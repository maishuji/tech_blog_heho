# Production Environment Variables Template
# Copy this file to .env.prod and fill in your actual values

# Django Production Settings
DJANGO_SECRET_KEY=your-production-secret-key-very-secure
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-server-ip
DJANGO_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database Configuration
DB_NAME=blog_prod_db
DB_USER=blog_prod_user
DB_PASSWORD=very-secure-production-password
DB_HOST=localhost
DB_PORT=5432

# Email Configuration (for contact forms, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# AWS S3 (if using for static/media files)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key  
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Compose Project Name
COMPOSE_PROJECT_NAME=blog_prod